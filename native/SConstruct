#!/usr/bin/env python
import os
import re

LIB = "stockfish_gd"
# Both can be overridden on the command line (sf_dir=../build/stockfish-light/src net=nn-61e7af4bb97d.nnue)
# to build another Stockfish tree. They are popped so that godot-cpp does not warn about unknown variables.
SF = ARGUMENTS.pop("sf_dir", "thirdparty/Stockfish/src")  # submodule at sf_19; NOT added to CPPPATH (its memory.h would shadow <memory.h>)
NET = ARGUMENTS.pop("net", "nn-1a298aa575a0.nnue")        # INCBIN resolves it from the compiler's cwd = this directory

with open(os.path.join(SF, "evaluate.h")) as f:
    tree_net = re.search(r'#define\s+EvalFileDefaultName\s+"([^"]+)"', f.read()).group(1)
if tree_net != NET:
    print("{}/evaluate.h embeds {}, not {}: pass net={}".format(SF, tree_net, NET, tree_net))
    Exit(1)

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})
if env["platform"] == "macos" and env["arch"] != "arm64":
    print("Build macOS with arch=arm64")
    Exit(1)

gd = env.Clone()                  # Godot-side code; never append to env itself (it leaks into godot-cpp)
gd.Append(CPPPATH=["src/"])
if env["platform"] == "android":
    gd.Append(LIBS=["log"])       # __android_log_write in the bridge

sf = env.Clone()                  # Stockfish + bridge share exactly these defines
sf.Append(CPPDEFINES=["IS_64BIT", "USE_POPCNT", ("USE_NEON", 8)])
sf.Append(CCFLAGS=["-iquote", SF])  # the bridge includes Stockfish's headers by name, from the tree being built
sf.Append(CXXFLAGS=["-fconstexpr-steps=500000000"])
sf.Append(CCFLAGS=["-O3", "-funroll-loops"])
if env["platform"] == "macos":
    sf.Append(CPPDEFINES=["USE_NEON_DOTPROD"], CCFLAGS=["-march=armv8.2-a+dotprod"])


def cpp(pattern, exclude=()):
    return [f for f in Glob(pattern) if os.path.basename(str(f)) not in exclude]


sf_src = (cpp(SF + "/*.cpp", exclude=("main.cpp",))
          + cpp(SF + "/nnue/*.cpp", exclude=("network.cpp",))
          + cpp(SF + "/nnue/features/*.cpp")
          + cpp(SF + "/syzygy/*.cpp"))
sf_objs = [sf.SharedObject(s) for s in sf_src]
# The bridge includes Stockfish's headers by name, found through -iquote. SCons's C scanner reads only CPPPATH,
# so it does not see them: without this, a header change would leave bridge/sf_bridge.os stale.
sf_headers = [h for sub in ("", "/nnue", "/nnue/features", "/syzygy") for h in Glob(SF + sub + "/*.h")]
bridge_objs = [sf.SharedObject(s) for s in cpp("bridge/*.cpp")]
sf.Depends(bridge_objs, sf_headers)
sf_objs += bridge_objs
net_obj = sf.SharedObject(SF + "/nnue/network.cpp")
sf.Depends(net_obj, NET)          # SCons does not scan .incbin

gd_objs = [gd.SharedObject(s) for s in Glob("src/*.cpp")]

suffix = env["suffix"].replace(".dev", "").replace(".universal", "")
lib = gd.SharedLibrary(
    "../game/bin/{}/{}{}{}{}".format(env["platform"], env.subst("$SHLIBPREFIX"), LIB, suffix,
                                     env.subst("$SHLIBSUFFIX")),
    source=gd_objs + sf_objs + [net_obj])
Default(lib)
